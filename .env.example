# Mapbox — get token at https://account.mapbox.com/access-tokens/
# Restrict this token in Mapbox dashboard: Allowed URLs → https://www.gojo.com.et/*
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase — get values from Firebase console → Project Settings → Your apps
# Restrict in Firebase console: Authentication → Settings → Authorized domains → add gojo.com.et
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Worker URL — after running `pnpm worker:deploy`
# Format: https://gojo-upload.<your-account>.workers.dev
NEXT_PUBLIC_WORKER_URL=

# R2 public URL — after enabling public access on the gojo-listings bucket in CF dashboard
# Format: https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
# Used in: worker/wrangler.toml (R2_PUBLIC_URL secret) + next.config.ts img-src
NEXT_PUBLIC_R2_PUBLIC_URL=

# Image resizing — ON by default via the free wsrv.nl proxy (src/lib/image.ts).
# Photos are served as width-capped WebP variants. Set to 0 to disable and serve
# original full-size R2 images.
NEXT_PUBLIC_IMAGE_RESIZE=1

# Cloudflare Turnstile — anti-spam on the contact form. Create a widget at
# Cloudflare dashboard → Turnstile. This is the PUBLIC site key; the matching
# secret goes in the worker (wrangler secret put TURNSTILE_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
