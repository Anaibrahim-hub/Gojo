# Mapbox — get token at https://account.mapbox.com/access-tokens/
# Restrict this token in Mapbox dashboard: Allowed URLs → https://www.gojo.com.et/*
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase — get values from Firebase console → Project Settings → Your apps
# Restrict in Firebase console: Authentication → Settings → Authorized domains → add gojo.com.et
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Worker URL — after running `pnpm worker:deploy`
# Format: https://gojo-upload.<your-account>.workers.dev
NEXT_PUBLIC_WORKER_URL=

# R2 public URL — after enabling public access on the gojo-listings bucket in CF dashboard
# Format: https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
# Used in: worker/wrangler.toml (R2_PUBLIC_URL secret) + next.config.ts img-src
NEXT_PUBLIC_R2_PUBLIC_URL=
